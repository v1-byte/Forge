# Strict native deployment configuration
FORGE_NATIVE_STRICT=1
FORGE_EXECUTE=1
FORGE_ENGINE_ROOT=/absolute/path/to/Forge/forge-engine
FORGE_WORKSPACE_ROOT=/absolute/path/to/workspaces
# Configure only after validating the command in an isolated worker:
# FORGE_INFERENCE_CMD=...
# FORGE_COMPILE_CMD=...
# FORGE_CONVERT_CMD=...
# FORGE_QUANTIZE_CMD=...
# FORGE_SERVE_CMD=...
# FORGE_TRAINING_CMD=...
# FORGE_EVALUATE_CMD=...
